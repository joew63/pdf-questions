# Copy this file to .env and fill in your keys. .env is gitignored.

# Required: Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Which Claude model the agent loop calls. Defaults to claude-opus-5 if unset.
# Swap to claude-sonnet-5 or claude-haiku-4-5 for cheaper/faster iteration
# while you're developing.
ANTHROPIC_MODEL=claude-opus-5

# Required: OpenAI API key, used only for embeddings
# (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Embedding model. text-embedding-3-small is the default OpenAI recommends
# for cost-sensitive small-scale use.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
